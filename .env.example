# Copy to .env and fill in. Never commit .env.
# The SMTP password belongs only here (and in your password manager), never in chat or notes.

# --- SMTP (outgoing mail) ---
OUTBOX_SMTP_HOST=smtp.example.com
# Default: 587 for starttls, 465 for ssl
# OUTBOX_SMTP_PORT=587
# starttls | ssl | none  ("none" is only allowed for localhost, for tests)
OUTBOX_SMTP_SECURITY=starttls
OUTBOX_SMTP_USER=you@example.com
OUTBOX_SMTP_PASSWORD=change-me
# Optional: name sent in the SMTP greeting (default: the system's own name)
# OUTBOX_SMTP_HELO=localhost

# --- Sender ---
OUTBOX_FROM_ADDRESS=you@example.com
# OUTBOX_FROM_NAME=Your Name

# --- Files ---
# JSON list of allowed recipients, see recipients.example.json. Only imported once, on the first start
# with an empty recipient registry; afterwards the database is the truth (see the registry section below).
OUTBOX_RECIPIENTS_FILE=recipients.json
OUTBOX_DB_PATH=outbox.db

# --- Limits (all optional, these are the defaults) ---
# OUTBOX_DRAFT_TTL_SECONDS=600
# OUTBOX_DRAFT_RETENTION_DAYS=7
# OUTBOX_MAX_PREPARES_PER_HOUR=20
# OUTBOX_MAX_SENDS_PER_HOUR=3
# OUTBOX_MAX_SENDS_PER_DAY=10
# OUTBOX_MAX_SUBJECT_CHARS=150
# OUTBOX_MAX_BODY_CHARS=20000
# OUTBOX_SMTP_TIMEOUT_SECONDS=30

# --- Attachments (off unless OUTBOX_ATTACHMENT_ROOT is set) ---
# Only Markdown (.md) notes below this folder, only inside the allowed folders (comma separated,
# relative to the root). Blocked folders win over allowed ones. Everything else is refused.
# OUTBOX_ATTACHMENT_ROOT must be an absolute path (a relative one would depend on the service's working directory).
# OUTBOX_ATTACHMENT_ROOT=/path/to/notes
# OUTBOX_ATTACHMENT_ALLOWED_FOLDERS=Projects
# OUTBOX_ATTACHMENT_DENIED_FOLDERS=Projects/Private
# OUTBOX_MAX_ATTACHMENTS=3
# OUTBOX_MAX_ATTACHMENT_BYTES=200000
# OUTBOX_MAX_ATTACHMENTS_TOTAL_BYTES=500000

# --- Recipient registry ---
# The allowed recipients live in the database. The old recipients file (OUTBOX_RECIPIENTS_FILE)
# is imported once, on the first start with an empty registry, and ignored afterwards.
# Manage recipients with the admin command line: outbox-admin (needs only OUTBOX_DB_PATH).
# OUTBOX_MAX_OPEN_SUGGESTIONS=5
# OUTBOX_MAX_SUGGESTIONS_PER_DAY=10
# OUTBOX_SUGGESTION_TTL_DAYS=30

# --- Remote access over HTTP (outbox-mcp-http) ---
# Public https address of this service, no path, e.g. https://mail.example.org
OUTBOX_PUBLIC_BASE_URL=https://mail.example.org
# Hash of the sign-in passphrase: uv run python -m outbox_mcp.auth.passwords
OUTBOX_OAUTH_PASSWORD_HASH=
# Sign-in database (absolute path in a service setup). Keep it private (mode 600).
OUTBOX_OAUTH_DB_PATH=auth.db
# OUTBOX_HTTP_PORT=8430
# OUTBOX_OAUTH_REDIRECT_URIS=
# OUTBOX_OAUTH_ACCESS_TTL_SECONDS=3600
# OUTBOX_OAUTH_REFRESH_TTL_DAYS=90
