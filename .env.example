# Copy to .env and fill in. Never commit .env.
# The SMTP password belongs only here (and in your password manager), never in chat or notes.

# --- SMTP (outgoing mail) ---
OUTBOX_SMTP_HOST=smtp.example.com
# Default: 587 for starttls, 465 for ssl
# OUTBOX_SMTP_PORT=587
# starttls | ssl | none  ("none" is only allowed for localhost, for tests)
OUTBOX_SMTP_SECURITY=starttls
OUTBOX_SMTP_USER=you@example.com
OUTBOX_SMTP_PASSWORD=change-me
# Optional: name sent in the SMTP greeting (default: the system's own name)
# OUTBOX_SMTP_HELO=localhost

# --- Sender ---
OUTBOX_FROM_ADDRESS=you@example.com
# OUTBOX_FROM_NAME=Your Name

# --- Files ---
# JSON list of allowed recipients, see recipients.example.json
OUTBOX_RECIPIENTS_FILE=recipients.json
OUTBOX_DB_PATH=outbox.db

# --- Limits (all optional, these are the defaults) ---
# OUTBOX_DRAFT_TTL_SECONDS=600
# OUTBOX_DRAFT_RETENTION_DAYS=7
# OUTBOX_MAX_PREPARES_PER_HOUR=20
# OUTBOX_MAX_SENDS_PER_HOUR=3
# OUTBOX_MAX_SENDS_PER_DAY=10
# OUTBOX_MAX_SUBJECT_CHARS=150
# OUTBOX_MAX_BODY_CHARS=20000
# OUTBOX_SMTP_TIMEOUT_SECONDS=30
