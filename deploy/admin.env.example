# Settings of the admin API only (see deploy/outbox-admin-api.service). No mail credentials here.
# Same database file as the mail service.
OUTBOX_DB_PATH=/path/to/outbox.db
# Create the hash with: python -m outbox_mcp.admin.passphrase  (the passphrase is typed hidden)
OUTBOX_ADMIN_PASSPHRASE_HASH=
# Exact origins of the admin app in the browser, comma separated. No wildcard. Empty = no browser origin allowed.
# OUTBOX_ADMIN_ALLOWED_ORIGINS=http://localhost:5173
# Host names the API answers to (default: localhost, 127.0.0.1, [::1]).
# OUTBOX_ADMIN_ALLOWED_HOSTS=localhost,127.0.0.1
# OUTBOX_ADMIN_PORT=8431
# Root folder for the folder tree and the rules (absolute path, the same folder as OUTBOX_ATTACHMENT_ROOT of the mail service).
# OUTBOX_ADMIN_ATTACHMENT_ROOT=/path/to/notes
